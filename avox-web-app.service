[Unit]
Description=Avox IT Services - Order Pricing Web App
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/avox-web-app
Environment=PORT=3000
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/avox-web-app/server.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
